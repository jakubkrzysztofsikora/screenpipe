# Serverless Ollama container with both models baked in.
# Designed for Scaleway Serverless Containers (min=0, max=1, scales to zero).
# Total image size: ~3.3 GB (nomic-embed-text ~270 MB + llama3.2:3b ~2.0 GB + Ollama ~1.0 GB)

FROM ollama/ollama:0.3.12

# Pull both models at build time — serverless has no persistent volumes.
# Poll with `ollama list` (no curl in image) which exits 0 when server is ready.
# --insecure flag: needed when building behind corporate TLS inspection (e.g. Cato VPN).
# This is build-time only and does not affect runtime TLS behaviour.
ENV OLLAMA_INSECURE=true
RUN ollama serve & \
    until ollama list > /dev/null 2>&1; do sleep 1; done && \
    ollama pull nomic-embed-text && \
    ollama pull llama3.2:3b && \
    (kill %1 2>/dev/null || true)
ENV OLLAMA_INSECURE=

ENV OLLAMA_HOST=0.0.0.0
EXPOSE 11434
CMD ["serve"]
